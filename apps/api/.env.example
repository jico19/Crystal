# ============================================================================
# Crystal Unified API Environment Configuration Template (.env.example)
# Copy this file to .env and adjust your credentials
# ============================================================================

# Port for Express API server
PORT=4000

# ----------------------------------------------------------------------------
# 1. PostgreSQL / Supabase Database Connection String
# ----------------------------------------------------------------------------
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crystal_db

# JWT Secret for Session Tokens & GoTrue Validation
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# ----------------------------------------------------------------------------
# 2. Driver Switches (local vs cloud)
# Options: 'local' (zero external dependencies) or cloud provider names
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
EMAIL_DRIVER=local
SMS_DRIVER=local

# ----------------------------------------------------------------------------
# 3. AWS S3 Storage Provider (Required when STORAGE_DRIVER=s3)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=crystal-prod-documents-secure

# ----------------------------------------------------------------------------
# 4. AWS SES Email Provider (Required when EMAIL_DRIVER=ses)
# ----------------------------------------------------------------------------
SES_FROM_EMAIL=notifications@crystalhomecare.com

# ----------------------------------------------------------------------------
# 5. Twilio SMS Provider (Required when SMS_DRIVER=twilio)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
